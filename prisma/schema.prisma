generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum MetabolicSex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum FitnessGoal {
  LOSE_WEIGHT
  MAINTAIN_WEIGHT
  GAIN_WEIGHT
}

enum TargetEligibility {
  GENERAL_ADULT
  SPECIALIST_GUIDANCE
  UNSURE
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Fitness profile for resting and daily energy estimates
  age           Int?
  metabolicSex  MetabolicSex?
  heightCm      Float?
  weightKg      Float?
  activityLevel ActivityLevel?
  goal          FitnessGoal?

  // No default: automated intake targets require an explicit selection.
  targetEligibility TargetEligibility?

  workouts        Workout[]
  customExercises Exercise[]
}

model Workout {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  title           String
  date            DateTime @default(now())
  durationMinutes Int?
  notes           String?

  user      User              @relation(fields: [userId], references: [id])
  exercises WorkoutExercise[]

  @@index([userId, date])
}

model Exercise {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  category    String
  description String?

  // Shared exercises explicitly store ownerId as null.
  // Custom exercises belong to their creator.
  ownerId String? @db.ObjectId
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  workouts WorkoutExercise[]

  @@index([ownerId])
}

model WorkoutExercise {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  workoutId  String @db.ObjectId
  exerciseId String @db.ObjectId

  // Position within this workout.
  order Int

  // Deleting a workout removes its exercise occurrences.
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  // A referenced catalog exercise cannot be deleted.
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  sets WorkoutSet[]

  @@index([workoutId, order])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  workoutExerciseId String @db.ObjectId
  setNumber         Int
  reps              Int

  // Kilograms internally; displayed as pounds.
  // null = not recorded; 0 = zero external load.
  // Preserve the existing MongoDB field name.
  weightKg Float? @map("weight")

  completed Boolean @default(false)

  // Removing a workout exercise removes its sets.
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId, setNumber])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
